{
  "annotations": { "list": [] },
  "editable": true,
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {},
        "datasource": "Prometheus",
        "hide": 0,
        "includeAll": true,
        "label": "Pipeline Target",
        "multi": true,
        "name": "ServiceName",
        "options": [],
        "query": "label_values(srt_stream_bitrate_kbps, service_name)",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Total Active Network Routes",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum(srt_active_services)", "refId": "A" }],
      "options": { "colorMode": "background", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "dark-red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "type": "stat",
      "title": "Total Crashed Network Routes",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "sum(srt_error_services)", "refId": "A" }],
      "options": { "colorMode": "background", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "dark-green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "type": "gauge",
      "title": "Cluster Active CPU Matrix (Per Node)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 },
      "id": 51,
      "targets": [ { "expr": "srt_system_cpu_usage", "legendFormat": "{{node}}", "refId": "A" } ],
      "options": { "reduceOptions": { "values": false, "calcs": [ "lastNotNull" ], "fields": "" }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 } ] }, "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "gauge",
      "title": "Cluster Active RAM Matrix (Per Node)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
      "id": 52,
      "targets": [ { "expr": "srt_system_memory_usage", "legendFormat": "{{node}}", "refId": "A" } ],
      "options": { "reduceOptions": { "values": false, "calcs": [ "lastNotNull" ], "fields": "" }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "dark-green", "value": null }, { "color": "dark-orange", "value": 70 }, { "color": "red", "value": 90 } ] }, "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "Live Processing Bitrate (Per Service)",
      "datasource": "Prometheus",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
      "id": 6,
      "targets": [
        { "expr": "srt_stream_bitrate_kbps{service_name=~\"^$ServiceName$\"}", "legendFormat": "{{service_name}} ({{node}})", "refId": "A" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisPlacement": "left", "drawStyle": "line", "fillOpacity": 30, "lineWidth": 2 }, "unit": "kbps" } }
    },
    {
      "type": "timeseries",
      "title": "Continuity Drop Spikes / Stream Fragmentation (Per Service)",
      "datasource": "Prometheus",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
      "id": 7,
      "targets": [
        { "expr": "rate(srt_stream_cc_errors_total{service_name=~\"^$ServiceName$\"}[1m])", "legendFormat": "CC Errors / sec - {{service_name}} ({{node}})", "refId": "A" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisPlacement": "left", "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 2 } } }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "SRT Cluster Advanced Telemetry",
  "uid": "srt_cluster",
  "version": 7
}
